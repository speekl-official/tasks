{
  "name": "@speekl/tasks",
  "version": "0.1.0",
  "description": "Local, git-versioned task manager for AI coding agents.",
  "keywords": [
    "tasks",
    "task-manager",
    "cli",
    "ai-agent",
    "agent",
    "coding-agent",
    "markdown",
    "frontmatter",
    "git"
  ],
  "homepage": "https://agenttasks.dev",
  "bugs": {
    "url": "https://github.com/speekl-official/tasks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speekl-official/tasks.git",
    "directory": "packages/tasks"
  },
  "license": "MIT",
  "author": "Dan Zabrotski",
  "type": "module",
  "bin": {
    "tasks": "./dist/index.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "lint": "eslint src test",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run lint && pnpm run check-types && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.1",
    "tsup": "^8.3.5",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.50.0",
    "vitest": "^2.1.8"
  }
}
